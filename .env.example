# Copier ce fichier en .production.env (ou .development.env) et remplacer les valeurs.
PORT=8080
DB_URI=mongodb://127.0.0.1:27017/bd_name
SALT_ROUNDS=10
# 32 caractères minimum (HS256). Générer par exemple avec : openssl rand -base64 48
JWT_SECRET=change-me-with-a-random-secret-of-32-chars-min
JWT_TTL=1d
