              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"Message : Invalid credentials\", () => pm.expect(pm.response.json().error).to.eql(\"Invalid credentials\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Connexion valide → 200 + token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Enregistre le JWT dans la variable `token`, utilisée par toutes les requêtes protégées.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 200\", () => pm.response.to.have.status(200));",
                  "const token = pm.response.json().token;",
                  "pm.test(\"Renvoie un JWT\", () => pm.expect(token).to.match(/^[\\w-]+\\.[\\w-]+\\.[\\w-]+$/));",
                  "pm.test(\"Le JWT contient l'utilisateur\", () => {",
                  "  const payload = JSON.parse(atob(token.split(\".\")[1].replace(/-/g, \"+\").replace(/_/g, \"/\")));",
                  "  pm.expect(payload.email).to.eql(pm.collectionVariables.get(\"email\"));",
                  "  pm.expect(payload._id).to.eql(pm.collectionVariables.get(\"userId\"));",
                  "  pm.expect(payload.exp).to.be.above(payload.iat);",
                  "});",
                  "pm.collectionVariables.set(\"token\", token);"
                ]
              }
            }
          ]
        }
      ]
    },
