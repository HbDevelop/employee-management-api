    {
      "name": "1 - Inscription (/auth/register)",
      "item": [
        {
          "name": "Sans corps → 400, 4 champs requis",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 400\", () => pm.response.to.have.status(400));",
                  "const fields = pm.response.json().map((e) => e.field);",
                  "pm.test(\"Champs en erreur : email, password, firstName, lastName\", () => pm.expect(fields).to.have.members([\"email\",\"password\",\"firstName\",\"lastName\"]));",
                  "pm.test(\"Email requis\", () => pm.expect(pm.response.json().find((e) => e.field === \"email\").error).to.eql(\"The user email is required\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Email et mot de passe invalides → 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"pas-un-email\",\n  \"password\": \"abc\",\n  \"firstName\": \"Ada\",\n  \"lastName\": \"Lovelace\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 400\", () => pm.response.to.have.status(400));",
                  "const fields = pm.response.json().map((e) => e.field);",
                  "pm.test(\"Champs en erreur : email, password\", () => pm.expect(fields).to.have.members([\"email\",\"password\"]));",
                  "pm.test(\"Email invalide\", () => pm.expect(pm.response.json().find((e) => e.field === \"email\").error).to.eql(\"Invalid email address\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "Inscription valide → 201",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Génère un email unique à chaque exécution, puis enregistre l'identifiant du compte dans `userId`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"firstName\": \"Ada\",\n  \"lastName\": \"Lovelace\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"email\", \"test.user.\" + Date.now() + \"@example.com\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 201\", () => pm.response.to.have.status(201));",
                  "const user = pm.response.json();",
                  "pm.test(\"Renvoie l'utilisateur créé\", () => {",
                  "  pm.expect(user.email).to.eql(pm.collectionVariables.get(\"email\"));",
                  "  pm.expect(user.firstName).to.eql(\"Ada\");",
                  "  pm.expect(user._id).to.match(/^[0-9a-f]{24}$/);",
                  "});",
                  "pm.test(\"Ne renvoie pas le mot de passe\", () => pm.expect(user).to.not.have.property(\"password\"));",
                  "pm.collectionVariables.set(\"userId\", user._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Email déjà utilisé → 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"firstName\": \"Ada\",\n  \"lastName\": \"Lovelace\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Statut 400\", () => pm.response.to.have.status(400));",
                  "const errors = pm.response.json();",
                  "pm.test(\"Erreur de doublon sur email\", () => {",
                  "  pm.expect(errors[0].field).to.eql(\"email\");",
                  "  pm.expect(errors[0].errors[0]).to.include(\"Duplicate constraint violation\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
