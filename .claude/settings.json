{
  "permissions": {
    "allow": [
      "Bash(docker compose run --rm verify)",
      "Bash(docker compose run --rm integration-tests)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "ask": [
      "Bash(git push:*)"
    ],
    "deny": [
      "Read(./*.env)"
    ]
  },
  "extraKnownMarketplaces": {
    "employee-management": {
      "source": {
        "source": "github",
        "repo": "HbDevelop/employee-management-api"
      }
    }
  },
  "enabledPlugins": {
    "spring-3tiers@employee-management": true
  }
}
